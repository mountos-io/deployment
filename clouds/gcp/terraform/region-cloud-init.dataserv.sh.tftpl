#!/bin/bash
set -euo pipefail

apt-get update -y
apt-get install -y curl jq openssl xfsprogs

# dataserv reads service config from the region secret store at boot.
# Only the bootstrap env below is written locally.

# Raft data dir at /mnt/raft (ephemeral per instance). GCP persistent disks get
# a stable /dev/disk/by-id/google-<device_name> symlink once attached; wait for
# udev to publish it so first boot does not fail on a short attach race.
RAFT_DEV=/dev/disk/by-id/google-raft
RAFT_DIR=/mnt/raft
install -d -m 0750 "$RAFT_DIR"
for _ in $(seq 1 60); do
  [ -b "$RAFT_DEV" ] && break
  sleep 2
done
[ -b "$RAFT_DEV" ] || { echo "raft device $RAFT_DEV not present" >&2; exit 1; }
if ! blkid "$RAFT_DEV" >/dev/null 2>&1; then
  mkfs.xfs "$RAFT_DEV"
fi
RAFT_UUID=$(blkid -s UUID -o value "$RAFT_DEV")
grep -q "$RAFT_UUID" /etc/fstab || echo "UUID=$RAFT_UUID $RAFT_DIR xfs defaults,nofail 0 2" >>/etc/fstab
mount -a

# ADVERTISE_ADDR is deliberately NOT set: dataserv auto-detects via the
# metadata server, which yields BOTH the external IP (clients reach dataserv
# directly, no proxy — hence the public-subnet requirement) and the internal
# IP (raft peer and hub<->region dials, which must stay inside the VPC).
# Setting ADVERTISE_ADDR forces discovery's explicit-address mode, which
# mirrors the ONE given address into both roles — pinning it to the external
# IP makes peers dial a public address from inside the same network, which GCP
# does not reliably route back (hairpin), and the failure is a silent timeout.
# The probe below only sanity-checks that an external IP exists at all.
meta() { curl -fsSL -H "Metadata-Flavor: Google" "http://metadata.google.internal/computeMetadata/v1/$1"; }
# '|| true' is load-bearing: with no access_config the metadata leaf 404s, and
# curl -f then exits 22, which under 'set -e' kills the script before the
# diagnostic below can name the real cause.
PUB_IP="$(meta 'instance/network-interfaces/0/access-configs/0/external-ip' || true)"
[ -n "$PUB_IP" ] || { echo "metadata server returned empty public IP (is this instance in the public subnet with an access_config?)" >&2; exit 1; }

install -d -m 0755 /etc/mountos

%{ if vault_provider == "hashicorp" ~}
# byo Vault config (CA + AppRole secret_id) is fetched by systemd ExecStartPre so
# the node self-heals when the operator publishes it after boot. See the helper below.
cat >/usr/local/bin/mos-fetch-vault-config.sh <<'EOF'
#!/bin/bash
# ExecStartPre: (re)fetch the Vault CA + AppRole secret_id from Secret Manager so
# the node self-heals when Vault publishes them after boot. Non-zero exit -> systemd retries.
# CA_SECRET "-" means the Vault serves a publicly-trusted cert; skip the CA fetch.
set -euo pipefail
PROJECT="$1"; CA_SECRET="$2"; SECRET_ID_SECRET="$3"; SECRET_ENV="$4"
meta() { curl -fsSL -H "Metadata-Flavor: Google" "http://metadata.google.internal/computeMetadata/v1/$1"; }
TOKEN="$(meta 'instance/service-accounts/default/token' | jq -r .access_token)"
if [ "$CA_SECRET" != "-" ]; then
  CA_FILE=/etc/mountos/vault-ca.pem
  curl -fsSL -H "Authorization: Bearer $TOKEN" \
    "https://secretmanager.googleapis.com/v1/projects/$PROJECT/secrets/$CA_SECRET/versions/latest:access" \
    2>/dev/null | jq -r '.payload.data // empty' | base64 -d > "$CA_FILE" 2>/dev/null || true
  if [ ! -s "$CA_FILE" ] || ! openssl x509 -in "$CA_FILE" -noout 2>/dev/null; then
    echo "waiting for Vault CA secret $CA_SECRET" >&2; exit 1
  fi
fi
SID="$(curl -fsSL -H "Authorization: Bearer $TOKEN" \
  "https://secretmanager.googleapis.com/v1/projects/$PROJECT/secrets/$SECRET_ID_SECRET/versions/latest:access" \
  2>/dev/null | jq -r '.payload.data // empty' | base64 -d 2>/dev/null || true)"
if [ -z "$SID" ]; then
  echo "waiting for AppRole secret_id $SECRET_ID_SECRET" >&2; exit 1
fi
umask 077
printf 'VAULT_HASHICORP_SECRET_ID=%s\n' "$SID" > "$SECRET_ENV"
EOF
chmod 0755 /usr/local/bin/mos-fetch-vault-config.sh
%{ endif ~}

cat >/etc/mountos/dataserv.env <<EOF
%{ if vault_provider == "hashicorp" ~}
VAULT_PROVIDER=hashicorp
VAULT_HASHICORP_ADDRESS=${vault_addr}
VAULT_HASHICORP_ROLE_ID=${vault_role_id}
%{ if vault_ca_source == "secret" ~}
VAULT_CACERT=/etc/mountos/vault-ca.pem
%{ endif ~}
%{ else ~}
VAULT_PROVIDER=gcp
VAULT_GCP_PROJECT_ID=${project_id}
%{ endif ~}
# Provider-agnostic, so it stays OUTSIDE the vault_provider branch. Secret
# names are mountos-<prefix>/..., so omitting this makes the service read
# unprefixed paths that do not exist. Harmless while the prefix is empty,
# which is what delays the failure until a prefix is first set.
VAULT_RESOURCE_PREFIX=${resource_prefix}
REGION_CLUSTER_ID=${region_cluster_id}
SERVICE_RPC_ADDR=${srpc_addr}
METAENGINE_ARENA_SIZE=${arena_size}
RAFT_DATA_DIR=/mnt/raft
%{ if dataserv_db_max_open_conns != "" ~}
DB_MAX_OPEN_CONNS=${dataserv_db_max_open_conns}
%{ endif ~}
EOF
chmod 0600 /etc/mountos/dataserv.env

# Install dataserv (+ gcserv when co-located). No license file: license arrives
# from the hub over the heartbeat (hublicense model).
curl -fsSL https://mountos.sh/install -o /tmp/mos-install.sh
if [ -n "${mos_installer_sha256}" ]; then echo "${mos_installer_sha256}  /tmp/mos-install.sh" | sha256sum -c - || { echo "installer checksum mismatch"; exit 1; }; else echo "WARN: mos_installer_sha256 unset — installing without verification"; fi
%{ if gcserv_colocated ~}
%{ if mos_version != "" ~}
bash /tmp/mos-install.sh --pkg mountos-dataserv --version ${mos_version}
bash /tmp/mos-install.sh --pkg mountos-gcserv --version ${mos_version}
%{ else ~}
bash /tmp/mos-install.sh --pkg mountos-dataserv
bash /tmp/mos-install.sh --pkg mountos-gcserv
%{ endif ~}
%{ else ~}
%{ if mos_version != "" ~}
bash /tmp/mos-install.sh --pkg mountos-dataserv --version ${mos_version}
%{ else ~}
bash /tmp/mos-install.sh --pkg mountos-dataserv
%{ endif ~}
%{ endif ~}

%{ if vault_provider == "hashicorp" ~}
# Pre-create the secret env file so the unit's optional EnvironmentFile always exists.
install -m 0600 /dev/null /etc/mountos/dataserv.secret.env
%{ endif ~}

cat >/etc/systemd/system/dataserv.service <<EOF
[Unit]
Description=mountOS dataserv
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/mountos/dataserv.env
%{ if vault_provider == "hashicorp" ~}
EnvironmentFile=-/etc/mountos/dataserv.secret.env
ExecStartPre=/usr/local/bin/mos-fetch-vault-config.sh ${project_id} %{ if vault_ca_source == "secret" }${region_vault_ca_secret}%{ else }-%{ endif } ${region_secret_id_secret} /etc/mountos/dataserv.secret.env
%{ endif ~}
# '-' prefix: db install is one-time schema setup against the SHARED regional
# DB. The first node in the quorum installs it; every other node (and every
# restart of any node) exits non-zero with "already installed". Without '-'
# that blocks ExecStart forever and the MIG's auto-healing recreates the
# instance in an endless loop.
ExecStartPre=-/usr/local/bin/dataserv db install
ExecStart=/usr/local/bin/dataserv
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

%{ if gcserv_colocated ~}
# Co-located gcserv: second unit, same bootstrap env. No db install (dataserv owns the schema).
# gcserv-specific overrides, read AFTER dataserv.env so they win. gcserv and
# the co-located dataserv share every other value.
#
# PORT: both binaries default to 8080 for their own HTTP (health/metrics)
# server, so without this gcserv crash-loops on "bind: address already in
# use" while the node still looks healthy. RPC_PORT is pinned explicitly
# rather than left to derive from the new PORT (it defaults to PORT+1), because
# the firewall rule for gcserv SRPC hard-codes 8081; moving PORT alone would
# silently shift the RPC port outside that rule.
cat >/etc/mountos/gcserv.env <<EOF
PORT=8090
RPC_PORT=8081
%{ if gcserv_db_max_open_conns != "" ~}
# gcserv holds its OWN pool against the regional DB, separate from the
# co-located dataserv's: background GC needs far fewer connections than the hot
# metadata path.
DB_MAX_OPEN_CONNS=${gcserv_db_max_open_conns}
%{ endif ~}
EOF
chmod 0600 /etc/mountos/gcserv.env

cat >/etc/systemd/system/gcserv.service <<EOF
[Unit]
Description=mountOS gcserv
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/mountos/dataserv.env
%{ if vault_provider == "hashicorp" ~}
EnvironmentFile=-/etc/mountos/dataserv.secret.env
ExecStartPre=/usr/local/bin/mos-fetch-vault-config.sh ${project_id} %{ if vault_ca_source == "secret" }${region_vault_ca_secret}%{ else }-%{ endif } ${region_secret_id_secret} /etc/mountos/dataserv.secret.env
%{ endif ~}
# gcserv.env is listed AFTER dataserv.env and carries every gcserv-specific
# override. Do NOT use Environment= for this: systemd.exec specifies that
# EnvironmentFile= settings override Environment= settings regardless of the
# order the lines appear in, so an Environment= override of any key that
# dataserv.env also defines is silently discarded. Later EnvironmentFile=
# entries DO override earlier ones, which is the mechanism that works here.
EnvironmentFile=/etc/mountos/gcserv.env
ExecStart=/usr/local/bin/gcserv
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF
%{ endif ~}

systemctl daemon-reload
systemctl enable --now dataserv
%{ if gcserv_colocated ~}
systemctl enable --now gcserv
%{ endif ~}
