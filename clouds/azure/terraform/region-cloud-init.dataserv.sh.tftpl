#!/bin/bash
set -euo pipefail

apt-get update -y
apt-get install -y curl jq openssl xfsprogs

# dataserv reads service config from the region secret store at boot.
# Only the bootstrap env below is written locally.

# Raft data dir at /mnt/raft (ephemeral per instance). Azure managed disks get
# a predictable /dev/disk/azure/scsi1/lun<N> path based on the LUN set on the
# data_disk block, but custom_data can run before udev publishes the symlink.
RAFT_DEV=/dev/disk/azure/scsi1/lun0
RAFT_DIR=/mnt/raft
install -d -m 0750 "$RAFT_DIR"
for _ in $(seq 1 60); do
  [ -b "$RAFT_DEV" ] && break
  sleep 2
done
[ -b "$RAFT_DEV" ] || { echo "raft device $RAFT_DEV not present" >&2; exit 1; }
if ! blkid "$RAFT_DEV" >/dev/null 2>&1; then
  mkfs.xfs "$RAFT_DEV"
fi
RAFT_UUID=$(blkid -s UUID -o value "$RAFT_DEV")
grep -q "$RAFT_UUID" /etc/fstab || echo "UUID=$RAFT_UUID $RAFT_DIR xfs defaults,nofail 0 2" >>/etc/fstab
mount -a

# ADVERTISE_ADDR is deliberately NOT set: it forces discovery's
# explicit-address mode, which mirrors the ONE given address into BOTH the
# public and private roles. Pinning it to the public IP makes peers dial a
# public address from inside the same VNet, which Azure does not reliably route
# back (hairpin), and the failure is a silent timeout rather than an error.
# The private IP is auto-detected from IMDS, which serves it correctly.
#
# The PUBLIC half, however, cannot be auto-detected on Azure, so it is resolved
# here and handed over as PUBLIC_ADVERTISE_ADDR, which sets ONLY the public role
# and leaves the private one to IMDS:
#   - the instance-metadata publicIpAddress leaf only ever served BASIC SKU
#     public IPs, and Basic SKU reached end of life in September 2025, so on any
#     current deployment it is empty;
#   - the addresses come from a public IP prefix, so they are not known at apply
#     time and cannot be templated in the way blockserv's static IP is.
# Two sources are tried, cheapest first. AWS and GCP need neither.
meta() { curl -fsSL -H "Metadata: true" "http://169.254.169.254/metadata/$1"; }

# Source 1: the Load Balancer Metadata API. It reports what Azure calls the
# INSTANCE LEVEL address, meaning this VM's own public IP rather than a load
# balancer frontend. Azure's troubleshooting page says it 404s when the VM
# "isn't associated with a load balancer", but a first-hand report shows it
# answering 200 with the address populated for a VM with a directly attached
# public IP and no load balancer. It costs one link-local request, so it is
# worth trying before reaching for ARM. A failure here is expected, not a fault,
# and it is NOT retried: Azure returns 404 both for "no load balancer" and for
# "the API is still being enabled", so a 404 proves nothing either way. ARM
# below is authoritative, so falling straight through to it beats guessing.
PUB_IP="$(meta 'loadbalancer?api-version=2020-10-01' 2>/dev/null | jq -r '.loadbalancer.publicIpAddresses[0].frontendIpAddress // empty' || true)"

# Source 2: ARM. Authoritative, and the fallback when source 1 is unavailable.
# The token comes from IMDS against the VM's user-assigned identity, so nothing
# is stored on the instance; region-iam.tf grants the matching Reader role.
if [ -z "$PUB_IP" ]; then
  for _ in $(seq 1 30); do
    TOKEN="$(meta "identity/oauth2/token?api-version=2018-02-01&resource=https%3A%2F%2Fmanagement.azure.com%2F&client_id=${identity_client_id}" 2>/dev/null | jq -r '.access_token // empty' || true)"
    RID="$(meta 'instance/compute?api-version=2021-02-01' 2>/dev/null | jq -r '.resourceId // empty' || true)"
    if [ -n "$TOKEN" ] && [ -n "$RID" ]; then
      # The instance's own NIC, expanded so the public IP address object comes
      # back inline rather than as a bare reference needing a second call.
      PUB_IP="$(curl -fsSL -H "Authorization: Bearer $TOKEN" \
        "https://management.azure.com$${RID}/networkInterfaces?api-version=2022-11-01&\$expand=ipConfigurations/publicIPAddress" \
        2>/dev/null | jq -r '[.value[].properties.ipConfigurations[].properties.publicIPAddress.properties.ipAddress // empty] | map(select(. != "")) | first // empty' || true)"
      [ -n "$PUB_IP" ] && break
    fi
    sleep 2
  done
fi
[ -n "$PUB_IP" ] || { echo "could not resolve this instance's public IP from either the load balancer metadata API or ARM after 60s (is the dataserv identity granted Reader on the resource group, and does the scale set assign instance-level public IPs?)" >&2; exit 1; }

install -d -m 0755 /etc/mountos

%{ if vault_provider == "hashicorp" ~}
# byo Vault config (CA + AppRole secret_id) is fetched by systemd ExecStartPre so
# the node self-heals when the operator publishes it after boot. See the helper below.
cat >/usr/local/bin/mos-fetch-vault-config.sh <<'EOF'
#!/bin/bash
# CA_SECRET "-" means the Vault serves a publicly-trusted cert; skip the CA fetch.
set -euo pipefail
VAULT_URI="$1"; CA_SECRET="$2"; SECRET_ID_SECRET="$3"; CLIENT_ID="$4"; SECRET_ENV="$5"
meta() { curl -fsSL -H "Metadata: true" "http://169.254.169.254/metadata/$1"; }
TOKEN="$(meta "identity/oauth2/token?api-version=2018-02-01&resource=https%3A%2F%2Fvault.azure.net&client_id=$CLIENT_ID" | jq -r .access_token)"
if [ "$CA_SECRET" != "-" ]; then
  CA_FILE=/etc/mountos/vault-ca.pem
  curl -fsSL -H "Authorization: Bearer $TOKEN" \
    "$${VAULT_URI}secrets/$CA_SECRET?api-version=7.4" \
    2>/dev/null | jq -r '.value // empty' > "$CA_FILE" 2>/dev/null || true
  if [ ! -s "$CA_FILE" ] || ! openssl x509 -in "$CA_FILE" -noout 2>/dev/null; then
    echo "waiting for Vault CA secret $CA_SECRET" >&2; exit 1
  fi
fi
SID="$(curl -fsSL -H "Authorization: Bearer $TOKEN" \
  "$${VAULT_URI}secrets/$SECRET_ID_SECRET?api-version=7.4" \
  2>/dev/null | jq -r '.value // empty' 2>/dev/null || true)"
if [ -z "$SID" ]; then
  echo "waiting for AppRole secret_id $SECRET_ID_SECRET" >&2; exit 1
fi
umask 077
printf 'VAULT_HASHICORP_SECRET_ID=%s\n' "$SID" > "$SECRET_ENV"
EOF
chmod 0755 /usr/local/bin/mos-fetch-vault-config.sh
%{ endif ~}

cat >/etc/mountos/dataserv.env <<EOF
%{ if vault_provider == "hashicorp" ~}
VAULT_PROVIDER=hashicorp
VAULT_HASHICORP_ADDRESS=${vault_addr}
VAULT_HASHICORP_ROLE_ID=${vault_role_id}
%{ if vault_ca_source == "kv" ~}
VAULT_CACERT=/etc/mountos/vault-ca.pem
%{ endif ~}
%{ else ~}
VAULT_PROVIDER=azure
VAULT_AZURE_URL=${key_vault_uri}
# Selects the VM's user-assigned identity for DefaultAzureCredential (IMDS
# does not default to a user-assigned identity).
AZURE_CLIENT_ID=${identity_client_id}
%{ endif ~}
# Provider-agnostic, so it stays OUTSIDE the vault_provider branch. Secret
# names are mountos-<prefix>/..., so omitting this makes the service read
# unprefixed paths that do not exist. Harmless while the prefix is empty,
# which is what delays the failure until a prefix is first set.
VAULT_RESOURCE_PREFIX=${resource_prefix}
REGION_CLUSTER_ID=${region_cluster_id}
SERVICE_RPC_ADDR=${srpc_addr}
METAENGINE_ARENA_SIZE=${arena_size}
RAFT_DATA_DIR=/mnt/raft
# Sets ONLY the public role. The private address still comes from IMDS, so raft
# peers and hub<->region dials keep using it. Do NOT replace this with
# ADVERTISE_ADDR, which would collapse both roles onto the public address.
PUBLIC_ADVERTISE_ADDR=$PUB_IP
%{ if dataserv_db_max_open_conns != "" ~}
DB_MAX_OPEN_CONNS=${dataserv_db_max_open_conns}
%{ endif ~}
EOF
chmod 0600 /etc/mountos/dataserv.env

# Install dataserv (+ gcserv when co-located). No license file: license arrives
# from the hub over the heartbeat (hublicense model).
curl -fsSL https://mountos.sh/install -o /tmp/mos-install.sh
if [ -n "${mos_installer_sha256}" ]; then echo "${mos_installer_sha256}  /tmp/mos-install.sh" | sha256sum -c - || { echo "installer checksum mismatch"; exit 1; }; else echo "WARN: mos_installer_sha256 unset — installing without verification"; fi
%{ if gcserv_colocated ~}
%{ if mos_version != "" ~}
bash /tmp/mos-install.sh --pkg mountos-dataserv --version ${mos_version}
bash /tmp/mos-install.sh --pkg mountos-gcserv --version ${mos_version}
%{ else ~}
bash /tmp/mos-install.sh --pkg mountos-dataserv
bash /tmp/mos-install.sh --pkg mountos-gcserv
%{ endif ~}
%{ else ~}
%{ if mos_version != "" ~}
bash /tmp/mos-install.sh --pkg mountos-dataserv --version ${mos_version}
%{ else ~}
bash /tmp/mos-install.sh --pkg mountos-dataserv
%{ endif ~}
%{ endif ~}

%{ if vault_provider == "hashicorp" ~}
# Pre-create the secret env file so the unit's optional EnvironmentFile always exists.
install -m 0600 /dev/null /etc/mountos/dataserv.secret.env
%{ endif ~}

cat >/etc/systemd/system/dataserv.service <<EOF
[Unit]
Description=mountOS dataserv
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/mountos/dataserv.env
%{ if vault_provider == "hashicorp" ~}
EnvironmentFile=-/etc/mountos/dataserv.secret.env
ExecStartPre=/usr/local/bin/mos-fetch-vault-config.sh ${key_vault_uri} %{ if vault_ca_source == "kv" }${region_vault_ca_secret}%{ else }-%{ endif } ${region_secret_id_secret} ${identity_client_id} /etc/mountos/dataserv.secret.env
%{ endif ~}
# '-' prefix: db install is one-time schema setup against the SHARED regional
# DB. The first node in the quorum installs it; every other node (and every
# restart of any node) exits non-zero with "already installed". Without '-'
# that blocks ExecStart forever, so dataserv never starts on any node but the
# installer. The VMSS Application Health extension would then report the node
# unhealthy and automatic_instance_repair would recreate it, on and on, since a
# replacement hits the same already-installed schema.
ExecStartPre=-/usr/local/bin/dataserv db install
ExecStart=/usr/local/bin/dataserv
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

%{ if gcserv_colocated ~}
# Co-located gcserv: second unit, same bootstrap env. No db install (dataserv owns the schema).
# gcserv-specific overrides, read AFTER dataserv.env so they win. gcserv and
# the co-located dataserv share every other value.
#
# PORT: both binaries default to 8080 for their own HTTP (health/metrics)
# server, so without this gcserv crash-loops on "bind: address already in
# use" while the node still looks healthy. RPC_PORT is pinned explicitly
# rather than left to derive from the new PORT (it defaults to PORT+1), because
# the firewall rule for gcserv SRPC hard-codes 8081; moving PORT alone would
# silently shift the RPC port outside that rule.
cat >/etc/mountos/gcserv.env <<EOF
PORT=8090
RPC_PORT=8081
%{ if gcserv_db_max_open_conns != "" ~}
# gcserv holds its OWN pool against the regional DB, separate from the
# co-located dataserv's: background GC needs far fewer connections than the hot
# metadata path.
DB_MAX_OPEN_CONNS=${gcserv_db_max_open_conns}
%{ endif ~}
EOF
chmod 0600 /etc/mountos/gcserv.env

cat >/etc/systemd/system/gcserv.service <<EOF
[Unit]
Description=mountOS gcserv
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/mountos/dataserv.env
%{ if vault_provider == "hashicorp" ~}
EnvironmentFile=-/etc/mountos/dataserv.secret.env
ExecStartPre=/usr/local/bin/mos-fetch-vault-config.sh ${key_vault_uri} %{ if vault_ca_source == "kv" }${region_vault_ca_secret}%{ else }-%{ endif } ${region_secret_id_secret} ${identity_client_id} /etc/mountos/dataserv.secret.env
%{ endif ~}
# gcserv.env is listed AFTER dataserv.env and carries every gcserv-specific
# override. Do NOT use Environment= for this: systemd.exec specifies that
# EnvironmentFile= settings override Environment= settings regardless of the
# order the lines appear in, so an Environment= override of any key that
# dataserv.env also defines is silently discarded. Later EnvironmentFile=
# entries DO override earlier ones, which is the mechanism that works here.
EnvironmentFile=/etc/mountos/gcserv.env
ExecStart=/usr/local/bin/gcserv
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF
%{ endif ~}

systemctl daemon-reload
systemctl enable --now dataserv
%{ if gcserv_colocated ~}
systemctl enable --now gcserv
%{ endif ~}
