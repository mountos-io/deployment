#!/bin/bash
set -euo pipefail

# blockserv reads service config from the region Vault (mountos/blockserv) at boot
# via the SAME region AppRole as dataserv. Only the bootstrap env below is local.

# Throughput-oriented cache volume at /mnt/blockcache. Wait for /dev/sdf to attach,
# format XFS only if not already a filesystem, mount with the blockserv I/O options.
#
# Mount options beyond the base set (noatime,nodev,noexec,nosuid,nofail):
#   logbsize=256k,logbufs=8  max out XFS's in-memory log buffering (default 32k/8k
#     total) so a busy segment-write workload flushes the journal far less often;
#     this is the standard XFS knob for write-heavy throughput, not a guess.
#   allocsize=4m  encourages larger speculative extent preallocation for the
#     mostly-large, mostly-sequential segment writes blockserv does, reducing
#     fragmentation versus XFS's default dynamic (small-file-biased) heuristic;
#     4m is a conservative, well-worn value, not tuned to any specific volume
#     size, workload shape below this may want a different one.
# TRIM is handled by the stock fstrim.timer (enabled below) rather than the
# `discard` mount option: batched TRIM avoids paying inline discard latency on
# every write while still reclaiming space periodically, the usual tradeoff for
# an IOPS/throughput-provisioned gp3 volume.
CACHE_DEV=/dev/sdf
CACHE_DIR=/mnt/blockcache
for _ in $(seq 1 60); do
  [ -b "$CACHE_DEV" ] && break
  sleep 2
done
install -d -m 0750 "$CACHE_DIR"
if ! blkid "$CACHE_DEV" >/dev/null 2>&1; then
  mkfs.xfs "$CACHE_DEV"
fi
CACHE_UUID=$(blkid -s UUID -o value "$CACHE_DEV")
grep -q "$CACHE_UUID" /etc/fstab || \
  echo "UUID=$CACHE_UUID $CACHE_DIR xfs rw,async,noatime,nodev,noexec,nosuid,nofail,logbsize=256k,logbufs=8,allocsize=4m 0 2" >>/etc/fstab
mount -a
systemctl enable --now fstrim.timer || echo "WARN: fstrim.timer unavailable; periodic TRIM disabled" >&2

# Host TCP tuning for clients on long-RTT links: 64 MiB autotuning ceilings,
# fq + bbr, PMTU probing, and no send-rate reset on idle pooled connections.
# tcp_mem stays at the kernel default, which the kernel sizes from host RAM.
# Written before blockserv starts, so its sockets pick up these values.
# blockserv never loads tcp_bbr itself; it uses bbr only when the kernel
# lists it. The modprobe line below is therefore required.
NET_CONF=/etc/sysctl.d/90-mountos-net.conf
cat >"$NET_CONF" <<'EOF'
net.core.rmem_max = 67108864
net.core.wmem_max = 67108864
net.ipv4.tcp_rmem = 4096 131072 67108864
net.ipv4.tcp_wmem = 4096 65536 67108864
net.core.default_qdisc = fq
net.ipv4.tcp_mtu_probing = 1
net.ipv4.tcp_slow_start_after_idle = 0
EOF
modprobe tcp_bbr 2>/dev/null || true
if grep -qw bbr /proc/sys/net/ipv4/tcp_available_congestion_control; then
  echo tcp_bbr >/etc/modules-load.d/bbr.conf
  echo "net.ipv4.tcp_congestion_control = bbr" >>"$NET_CONF"
else
  echo "WARN: tcp_bbr unavailable; TCP congestion control stays cubic" >&2
fi
sysctl --system >/dev/null || echo "WARN: sysctl --system reported errors; check $NET_CONF" >&2
# default_qdisc covers only qdiscs made after the sysctl load. The default-route
# interface got its qdisc at boot, before it, so replace it here. A multi-queue
# NIC gets an explicit mq root, whose per-queue children the kernel makes from
# default_qdisc (fq). A single-queue NIC gets fq as its root. On later boots
# systemd-sysctl loads the file first.
QDISC_IF=$(ip -o route show default | awk '{print $5; exit}')
if [ -n "$QDISC_IF" ] && command -v tc >/dev/null 2>&1; then
  if tc qdisc show dev "$QDISC_IF" | grep -q '^qdisc mq '; then
    tc qdisc replace dev "$QDISC_IF" root handle 1: mq 2>/dev/null || true
  else
    tc qdisc replace dev "$QDISC_IF" root fq 2>/dev/null || true
  fi
  tc qdisc show dev "$QDISC_IF" | grep -qw fq || echo "WARN: fq is not the qdisc on $QDISC_IF" >&2
else
  echo "WARN: fq not applied (no default-route interface or no tc)" >&2
fi

# ADVERTISE_ADDR is deliberately NOT set: blockserv auto-detects via IMDS,
# which yields BOTH public-ipv4 (clients reach the byte plane directly) and
# local-ipv4 (HA peer replication and appserv<->blockserv SRPC, which must stay
# inside the VPC). Setting ADVERTISE_ADDR forces discovery's explicit-address
# mode, which mirrors the ONE given address into both roles. Pinning it to the
# Elastic IP would make same-VPC peers dial a public address and hit the AWS
# hairpin limitation (an instance cannot reliably reach a VPC-mate's public IP).
#
TOKEN=$(curl -fsSL -X PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
%{ if use_eip ~}
# The member's Elastic IP is still terraform-known, so instead of trusting IMDS
# blindly we WAIT for the EIP association to land: a freshly-booted instance
# briefly reports its ephemeral public IP, and advertising that would publish a
# wrong, short-lived client address. Poll until IMDS agrees with the EIP.
for _ in $(seq 1 60); do
  PUB_IP=$(curl -fsSL -H "X-aws-ec2-metadata-token: $TOKEN" \
    http://169.254.169.254/latest/meta-data/public-ipv4 || true)
  [ "$PUB_IP" = "${advertise_addr}" ] && break
  sleep 2
done
[ "$PUB_IP" = "${advertise_addr}" ] || { echo "EIP ${advertise_addr} never associated (IMDS reports '$PUB_IP'); refusing to advertise a transient address" >&2; exit 1; }
%{ else ~}
# No EIP for this member (use_eip=false, past the account's quota) - the subnet's
# own auto-assigned public IP is this member's ONLY address, nothing to wait for
# it to match; just wait for IMDS to report it at all (a brief delay right at
# boot is normal), unlike the EIP case there is no "wrong, short-lived" address
# to guard against here.
for _ in $(seq 1 60); do
  PUB_IP=$(curl -fsSL -H "X-aws-ec2-metadata-token: $TOKEN" \
    http://169.254.169.254/latest/meta-data/public-ipv4 || true)
  [ -n "$PUB_IP" ] && break
  sleep 2
done
[ -n "$PUB_IP" ] || { echo "no public IP ever appeared on IMDS for this ephemeral-address member" >&2; exit 1; }
%{ endif ~}

install -d -m 0755 /etc/mountos

%{ if vault_provider == "hashicorp" ~}
# byo Vault config (CA + AppRole secret_id) is fetched by systemd ExecStartPre so
# the node self-heals when the operator publishes it after boot. See the helper below.
cat >/usr/local/bin/mos-fetch-vault-config.sh <<'EOF'
#!/bin/bash
# ExecStartPre: (re)fetch the Vault CA + AppRole secret_id from SSM so the node
# self-heals when Vault publishes them after boot. Non-zero exit -> systemd retries.
# CA_PARAM "-" means the Vault serves a publicly-trusted cert; skip the CA fetch.
set -euo pipefail
CA_PARAM="$1"; SECRET_PARAM="$2"; SSM_REGION="$3"; SECRET_ENV="$4"
if [ "$CA_PARAM" != "-" ]; then
  CA_FILE=/etc/mountos/vault-ca.pem
  aws ssm get-parameter --name "$CA_PARAM" --region "$SSM_REGION" --query Parameter.Value --output text > "$CA_FILE" 2>/dev/null || true
  if [ ! -s "$CA_FILE" ] || ! openssl x509 -in "$CA_FILE" -noout 2>/dev/null; then
    echo "waiting for Vault CA $CA_PARAM" >&2; exit 1
  fi
fi
SID="$(aws ssm get-parameter --name "$SECRET_PARAM" --with-decryption --region "$SSM_REGION" --query Parameter.Value --output text 2>/dev/null || true)"
if [ -z "$SID" ] || [ "$SID" = "None" ]; then
  echo "waiting for AppRole secret_id $SECRET_PARAM" >&2; exit 1
fi
umask 077
printf 'VAULT_HASHICORP_SECRET_ID=%s\n' "$SID" > "$SECRET_ENV"
EOF
chmod 0755 /usr/local/bin/mos-fetch-vault-config.sh
%{ endif ~}

cat >/etc/mountos/blockserv.env <<EOF
%{ if vault_provider == "hashicorp" ~}
VAULT_PROVIDER=hashicorp
VAULT_HASHICORP_ADDRESS=${vault_addr}
VAULT_HASHICORP_ROLE_ID=${vault_role_id}
%{ if vault_ca_source == "ssm" ~}
VAULT_CACERT=/etc/mountos/vault-ca.pem
%{ endif ~}
%{ else ~}
VAULT_PROVIDER=aws
VAULT_AWS_REGION=${region}
%{ endif ~}
VAULT_RESOURCE_PREFIX=${resource_prefix}
REGION_CLUSTER_ID=${region_cluster_id}
SERVICE_RPC_ADDR=${srpc_addr}
BLOCK_VOLUME_ID=${block_volume_id}
BLOCK_PORT=9100
PORT_RANGE=9500-9600
STORAGE_MOUNT_ROOT_PATH=$CACHE_DIR
DELETE_MODE=${delete_mode}
EOF
chmod 0600 /etc/mountos/blockserv.env

# Install blockserv. No db (data-plane node). No license file (hublicense model).
curl -fsSL https://mountos.sh/install -o /tmp/mos-install.sh
if [ -n "${mos_installer_sha256}" ]; then echo "${mos_installer_sha256}  /tmp/mos-install.sh" | sha256sum -c - || { echo "installer checksum mismatch"; exit 1; }; else echo "WARN: mos_installer_sha256 unset; installing without verification"; fi
%{ if mos_version != "" ~}
bash /tmp/mos-install.sh --pkg mountos-blockserv --version ${mos_version}
%{ else ~}
bash /tmp/mos-install.sh --pkg mountos-blockserv
%{ endif ~}

%{ if vault_provider == "hashicorp" ~}
# Pre-create the secret env file so the unit's optional EnvironmentFile always exists.
install -m 0600 /dev/null /etc/mountos/blockserv.secret.env
%{ endif ~}

cat >/etc/systemd/system/blockserv.service <<EOF
[Unit]
Description=mountOS blockserv
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/mountos/blockserv.env
%{ if vault_provider == "hashicorp" ~}
EnvironmentFile=-/etc/mountos/blockserv.secret.env
ExecStartPre=/usr/local/bin/mos-fetch-vault-config.sh %{ if vault_ca_source == "ssm" }/${name_root}/region/vault-ca%{ else }-%{ endif } /${name_root}/region/vault-secret-id ${region} /etc/mountos/blockserv.secret.env
%{ endif ~}
ExecStart=/usr/local/bin/blockserv
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now blockserv
