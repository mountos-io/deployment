#!/bin/bash
set -euo pipefail

# appserv reads ALL config from Vault at boot via AppRole. Only the bootstrap
# env below is written locally. ADVERTISE_ADDR is the instance private IPv4 (IMDSv2).
TOKEN=$(curl -fsSL -X PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
PRIV_IP=$(curl -fsSL -H "X-aws-ec2-metadata-token: $TOKEN" \
  http://169.254.169.254/latest/meta-data/local-ipv4)
[ -n "$PRIV_IP" ] || { echo "IMDS returned empty private IP" >&2; exit 1; }

install -d -m 0755 /etc/mountos

# Self-signed cert so the ALB re-encrypts to appserv (HTTPS-only when TLS_* + HTTPS_PORT set).
openssl req -x509 -newkey rsa:2048 -nodes -keyout /etc/mountos/appserv-key.pem -out /etc/mountos/appserv-cert.pem -days 3650 -subj "/CN=appserv" -addext "subjectAltName=IP:$PRIV_IP"
chmod 0600 /etc/mountos/appserv-key.pem

%{ if vault_provider == "hashicorp" ~}
# byo Vault config (CA + AppRole secret_id) is fetched by systemd ExecStartPre so
# the node self-heals when the operator publishes it after boot. See the helper below.
# CA param "-" skips the CA fetch: a byo Vault with a publicly-trusted
# certificate needs no private CA (system CAs verify it).
cat >/usr/local/bin/mos-fetch-vault-config.sh <<'EOF'
#!/bin/bash
# ExecStartPre: (re)fetch the Vault CA + AppRole secret_id from SSM so the node
# self-heals when Vault publishes them after boot. Non-zero exit -> systemd retries.
# CA_PARAM "-" means the Vault serves a publicly-trusted cert; skip the CA fetch.
set -euo pipefail
CA_PARAM="$1"; SECRET_PARAM="$2"; SSM_REGION="$3"; SECRET_ENV="$4"
if [ "$CA_PARAM" != "-" ]; then
  CA_FILE=/etc/mountos/vault-ca.pem
  aws ssm get-parameter --name "$CA_PARAM" --region "$SSM_REGION" --query Parameter.Value --output text > "$CA_FILE" 2>/dev/null || true
  if [ ! -s "$CA_FILE" ] || ! openssl x509 -in "$CA_FILE" -noout 2>/dev/null; then
    echo "waiting for Vault CA $CA_PARAM" >&2; exit 1
  fi
fi
SID="$(aws ssm get-parameter --name "$SECRET_PARAM" --with-decryption --region "$SSM_REGION" --query Parameter.Value --output text 2>/dev/null || true)"
if [ -z "$SID" ] || [ "$SID" = "None" ]; then
  echo "waiting for AppRole secret_id $SECRET_PARAM" >&2; exit 1
fi
umask 077
printf 'VAULT_HASHICORP_SECRET_ID=%s\n' "$SID" > "$SECRET_ENV"
EOF
chmod 0755 /usr/local/bin/mos-fetch-vault-config.sh
%{ endif ~}

cat >/etc/mountos/appserv.env <<EOF
%{ if vault_provider == "hashicorp" ~}
VAULT_PROVIDER=hashicorp
VAULT_HASHICORP_ADDRESS=${vault_addr}
VAULT_HASHICORP_ROLE_ID=${vault_role_id}
%{ if vault_ca_source == "ssm" ~}
VAULT_CACERT=/etc/mountos/vault-ca.pem
%{ endif ~}
%{ else ~}
VAULT_PROVIDER=aws
VAULT_AWS_REGION=${region}
%{ endif ~}
VAULT_RESOURCE_PREFIX=${resource_prefix}
PORT=8080
HTTPS_PORT=8443
TLS_CERT_FILE=/etc/mountos/appserv-cert.pem
TLS_KEY_FILE=/etc/mountos/appserv-key.pem
ADVERTISE_ADDR=$PRIV_IP
%{ if appserv_db_max_open_conns != "" ~}
DB_MAX_OPEN_CONNS=${appserv_db_max_open_conns}
%{ endif ~}
EOF
chmod 0600 /etc/mountos/appserv.env

# Install appserv (built-in free 5 TiB; no license required).
curl -fsSL https://mountos.sh/install -o /tmp/mos-install.sh
if [ -n "${mos_installer_sha256}" ]; then echo "${mos_installer_sha256}  /tmp/mos-install.sh" | sha256sum -c - || { echo "installer checksum mismatch"; exit 1; }; else echo "WARN: mos_installer_sha256 unset; installing without verification"; fi
%{ if mos_version != "" ~}
bash /tmp/mos-install.sh --pkg mountos-appserv --version ${mos_version}
%{ else ~}
bash /tmp/mos-install.sh --pkg mountos-appserv
%{ endif ~}

%{ if vault_provider == "hashicorp" ~}
# Pre-create the secret env file so the unit's optional EnvironmentFile always exists.
install -m 0600 /dev/null /etc/mountos/appserv.secret.env
%{ endif ~}

# Memory safety for every server unit: the OS must not OOM-kill it, and a swap file absorbs
# memory pressure (min(RAM, 8 GiB)). Never set MemoryMax on these units, it kills instead of
# swapping. vm.* keys live in their own file, 90-mountos-net.conf belongs to the UDP host tuning.
if [ ! -e /swapfile ]; then
  SIZE_MIB=$(awk '/MemTotal/ {m=int($2/1024); print (m>8192)?8192:m}' /proc/meminfo)
  fallocate -l "$SIZE_MIB"M /swapfile || dd if=/dev/zero of=/swapfile bs=1M count="$SIZE_MIB"
  chmod 600 /swapfile
  mkswap /swapfile >/dev/null
  swapon /swapfile
  grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw,pri=10,nofail 0 0' >>/etc/fstab
fi
cat >/etc/sysctl.d/91-mountos-mem.conf <<'EOF'
vm.swappiness = 10
vm.overcommit_memory = 0
EOF
sysctl --system >/dev/null || echo "WARN: sysctl --system reported errors; check /etc/sysctl.d/91-mountos-mem.conf" >&2
# Kernel TLS module for the block data plane. The mountOS binaries never load
# it; they probe it once at startup and stay on Noise when it is missing.
modprobe tls 2>/dev/null || true
if [ -d /sys/module/tls ]; then
  echo tls >/etc/modules-load.d/tls.conf
else
  echo "WARN: kernel tls module unavailable; the block data plane stays on Noise" >&2
fi

cat >/etc/systemd/system/appserv.service <<EOF
[Unit]
Description=mountOS appserv
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/mountos/appserv.env
%{ if vault_provider == "hashicorp" ~}
EnvironmentFile=-/etc/mountos/appserv.secret.env
ExecStartPre=/usr/local/bin/mos-fetch-vault-config.sh %{ if vault_ca_source == "ssm" }/${name_root}/hub/vault-ca%{ else }-%{ endif } /${name_root}/appserv/vault-secret-id ${region} /etc/mountos/appserv.secret.env
%{ endif ~}
# '-' prefix: db install is one-time schema setup against the shared admin DB.
# Once installed (by this node's first boot, a replacement instance, or an HA
# sibling), every later start hits "already installed" and exits non-zero.
# Without '-', that blocks ExecStart on every restart and upgrade thereafter.
ExecStartPre=-/usr/local/bin/appserv db install
ExecStart=/usr/local/bin/appserv
Restart=always
OOMScoreAdjust=-900
MemorySwapMax=infinity
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now appserv
