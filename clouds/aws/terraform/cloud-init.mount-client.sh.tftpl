#!/bin/bash
set -euo pipefail

# Disposable mount-test client. Installs ONLY the mountos client + FUSE; holds
# no credentials. The volume access key pair is supplied at mount time by the
# operator (see the aws-demo-env skill), so it never lands in user_data,
# instance metadata, or tfstate.

# fuse3 is what the client mounts through; the rest is for inspecting a mount
# by hand (ls/cat/dd live in coreutils, already present).
dnf install -y fuse3 tar

# ONE --pkg per invocation: the installer honors only the LAST --pkg flag when
# given more than one in a single call, silently skipping the earlier ones.
curl -fsSL https://mountos.sh/install -o /tmp/mos-install.sh
if [ -n "${mos_installer_sha256}" ]; then echo "${mos_installer_sha256}  /tmp/mos-install.sh" | sha256sum -c - || { echo "installer checksum mismatch"; exit 1; }; else echo "WARN: mos_installer_sha256 unset — installing without verification"; fi
%{ if mos_version != "" ~}
bash /tmp/mos-install.sh --pkg mountos-cli-linux --version ${mos_version}
%{ else ~}
bash /tmp/mos-install.sh --pkg mountos-cli-linux
%{ endif ~}

# Mount point the operator's mount command targets by default.
#
# Owned by the LOGIN user, not root: the whole point of this box is running
# filesystem tests against the mount, and a root-owned FUSE mount forces every
# write through sudo — awkward to drive, and not how a real user runs the
# client. An unprivileged mount also keeps created files owned by the tester,
# so later inspection isn't muddied by root-owned artifacts.
#
# ssm-user is created by the SSM agent, which can start AFTER cloud-init, so
# chown when it already exists and otherwise fall back to a sticky
# world-writable mode (same semantics as /tmp) that any login user can mount
# over. Without this the directory stays root:root and the first unprivileged
# mount fails on permissions.
install -d -m 0755 /mnt/mountos
if id -u ssm-user >/dev/null 2>&1; then
  chown ssm-user:ssm-user /mnt/mountos
else
  chmod 1777 /mnt/mountos
fi

# Credentials stub: correct variable names and 0600 perms pre-set, VALUES LEFT
# EMPTY ON PURPOSE. The operator fills it in from their own local profile
# inside an interactive session — never through SSM send-command, whose
# parameters are recorded verbatim in command history and CloudTrail.
#
# Written to /etc/skel FIRST, then copied into an existing home. ssm-user is
# normally created by the SSM agent when the FIRST session starts, which is
# after cloud-init, so a home-directory-only write silently does nothing and
# the MOTD then tells the operator to source a file that was never created.
# /etc/skel is what the account creation copies from, so it covers that case.
install -m 0600 /dev/null /etc/skel/.mountos_profile
cat >/etc/skel/.mountos_profile <<'PROFILE'
# mountOS volume credentials for this disposable mount tester.
#
# Fill in, then:  source ~/.mountos_profile && mountos mount /mnt/mountos
# (mount-point is positional; -s is a switch that reads the secret from
# stdin/prompt, so the secret never lands on argv where ps can read it.)
#
# Before pasting real values, keep them out of shell history:
#     unset HISTFILE
export MOUNTOS_DISCOVERY_URL=
export MOUNTOS_ACCESS_KEY_ID=
export MOUNTOS_SECRET_ACCESS_KEY=
PROFILE
chmod 0600 /etc/skel/.mountos_profile

# Covers the other order too: if the agent already created ssm-user before this
# ran, /etc/skel was never consulted for it, so seed the home copy directly.
if id -u ssm-user >/dev/null 2>&1; then
  install -d -m 0700 -o ssm-user -g ssm-user /home/ssm-user
  install -m 0600 -o ssm-user -g ssm-user /etc/skel/.mountos_profile /home/ssm-user/.mountos_profile
fi

# user_allow_other: the client may mount with -o allow_other so a non-root
# shell can read the mount; harmless on a disposable single-purpose tester.
grep -q '^user_allow_other' /etc/fuse.conf 2>/dev/null || echo user_allow_other >>/etc/fuse.conf

# Breadcrumb so `ssm start-session` lands on something self-explanatory rather
# than a bare prompt — this box is created and destroyed repeatedly, so the
# next person (or the next session) should not have to reconstruct the usage.
cat >/etc/motd <<'EOF'
mountOS mount-test client (disposable).

  mountos --version

  # mount-point is POSITIONAL (there is no -m). With MOUNTOS_DISCOVERY_URL,
  # MOUNTOS_ACCESS_KEY_ID and MOUNTOS_SECRET_ACCESS_KEY exported:
  mountos mount /mnt/mountos

  # or pass the key id and feed the secret on stdin. -s is a SWITCH, not a
  # value: the secret never goes on argv, where ps/history would expose it.
  echo "<secret>" | mountos mount /mnt/mountos -a <access-key-id> -s

Mount UNPRIVILEGED (no sudo): /mnt/mountos is owned by the login user so test
writes do not need root. sudo would also drop the exported MOUNTOS_* vars.

Credentials are NOT stored on this box - export them for the session only.
This instance lives in the DEFAULT VPC on purpose: it must reach dataserv over
the PUBLIC internet, like a real client. An instance inside the mountOS VPC
cannot reliably reach a VPC-mate's public IP (AWS hairpin) and would only work
via INTERNAL_PREFER_PRIVATE_DISCOVERY, i.e. a path no real user takes.
EOF

echo "mount-client ready: $(/usr/local/bin/mountos --version 2>&1 | head -1)"
