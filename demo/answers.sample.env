# mountOS AWS demo/dev environment — answers.env for `make bootstrap` /
# `make region-bootstrap` when using demo/terraform.tfvars. Copy to
# answers.env and fill in. Mirrors the main answers.sample.env; see
# mountos-servers/docs/ai/static/skills/deploy.md for the full walkthrough.

MODE=non-production
CLOUD=aws
AWS_REGION=us-west-2
HUB_DOMAIN=                 # REQUIRED, same value as hub_domain in terraform.tfvars
RESOURCE_PREFIX=            # same value as resource_prefix in terraform.tfvars, if set

VAULT_PROVIDER=aws

# ---------- admin DB (mountos_admin), provisioned mode ----------
ADMIN_DB_MODE=provision-rds
ADMIN_DB_DIALECT=postgresql
ADMIN_DB_PROVIDER_VERSION=18
# Fill these in AFTER `make apply` (terraform output), right before running
# `make bootstrap`:
#ADMIN_DB_HOST=          # `terraform output admin_db_host`
#ADMIN_DB_SECRET_ARN=    # `terraform output admin_db_secret_arn`

# ---------- region DB (mountos_data) — shared instance, byo mode ----------
# region_db_mode=byo in terraform.tfvars points REGION_DB_URL at the SAME RDS
# instance as the admin DB (a different database on it), not a separate
# provisioned instance. Build this DSN by hand after `make apply` + creating
# the mountos_data database (`CREATE DATABASE mountos_data;` on the shared
# instance) and EXPORT it in your shell right before `make region-bootstrap`
# — do not paste the password into this file:
#   export REGION_DB_URL="postgresql://mountos:<password>@<same-admin-db-host>/mountos_data?sslmode=require"
# (password: the admin DB's own master password, fetched via
# `aws secretsmanager get-secret-value --secret-id $(terraform output -raw admin_db_secret_arn)`)
REGION_DB_DIALECT=postgresql
REGION_DB_PROVIDER_VERSION=18
